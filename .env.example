# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=splitsmart-super-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=splitsmart_db
DB_POOL_NAME=splitsmart_pool
DB_POOL_SIZE=10

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
